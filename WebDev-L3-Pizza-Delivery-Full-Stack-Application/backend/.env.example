# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas or Local MongoDB; if empty or fails, auto-falls back to MongoMemoryServer)
MONGODB_URI=mongodb://127.0.0.1:27017/pizza_delivery

# JWT Secrets
JWT_SECRET=pizzacraft_super_secure_jwt_secret_key_2026_dev
JWT_EXPIRE=7d

# Admin Credentials (Initial setup)
ADMIN_EMAIL=admin@pizzacraft.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Head Chef & Inventory Admin

# Razorpay Test Credentials (Test mode)
# If left as test placeholders, mock test checkout works seamlessly; or provide real rzp_test_... keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret

# Email Configuration (Nodemailer)
# If left empty, automated Ethereal / test transporter logs preview URLs to console and responses
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@pizzacraft.com
FROM_NAME=PizzaCraft Artisanal Pizzas

# Inventory Low-Stock Alert Configuration
LOW_STOCK_THRESHOLD=20
ALERT_CRON_SCHEDULE=*/5 * * * *

